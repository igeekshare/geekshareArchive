{
  "name": "geekshare-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run preview",
    "dev:ui": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-worker-assets.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy:dev": "npm run build && wrangler deploy --env dev",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "cf:typegen": "wrangler types worker-configuration.d.ts",
    "db:d1:local": "wrangler d1 migrations apply geekshare-archive --local",
    "db:d1:dev": "wrangler d1 migrations apply DB --env dev --remote",
    "db:d1:remote": "wrangler d1 migrations apply geekshare-archive --remote",
    "db:export-d1": "tsx scripts/export-d1.ts",
    "db:import-d1:local": "wrangler d1 execute geekshare-archive --local --file .data/d1-import.sql",
    "db:import-d1:dev": "wrangler d1 execute DB --env dev --remote --file .data/d1-import.sql",
    "db:import-d1:remote": "wrangler d1 execute geekshare-archive --remote --file .data/d1-import.sql",
    "media:repair": "tsx scripts/repair-media.ts",
    "webhook:register": "node scripts/register-webhook.mjs",
    "assets:verify": "node scripts/verify-worker-assets.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:studio": "prisma studio",
    "import:json": "tsx scripts/import-json.ts",
    "sync:channel": "tsx scripts/sync-channel.ts"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-virtual": "^3.13.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "lucide-react": "^0.468.0",
    "next": "^16.2.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.0",
    "cheerio": "^1.1.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.0",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0",
    "wrangler": "^4.65.0"
  }
}
